{
  "name": "mm-llm",
  "version": "0.3.1",
  "private": true,
  "author": "JOUNGWOOK KWON",
  "description": "Medical MBA desktop workspace for ChatKHU Gateway",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "icon": "node scripts/render-icon.mjs",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "dist:mac:prepare": "node scripts/ensure-canvas-binaries.mjs mac && npm run icon && npm run build",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never",
    "dist:mac": "npm run dist:mac:prepare && npm run dist:mac:arm64 && npm run dist:mac:x64 && node scripts/merge-mac-update-metadata.mjs",
    "dist:mac:unsigned:arm64": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never --config.mac.identity=null",
    "dist:mac:unsigned:x64": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 --publish never --config.mac.identity=null",
    "dist:mac:unsigned": "npm run dist:mac:prepare && npm run dist:mac:unsigned:arm64 && npm run dist:mac:unsigned:x64",
    "dist:win": "node scripts/ensure-canvas-binaries.mjs win && npm run icon && npm run build && electron-builder --win nsis --x64 --publish never",
    "test": "node --test tests/*.test.mjs && npm run ui:check",
    "ui:audit": "node scripts/audit-ui-css.mjs",
    "ui:check": "tsx --test --test-concurrency=1 tests/sidebar-ui-dom.test.tsx"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.20",
    "@napi-rs/canvas": "^1.0.9",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "lucide-react": "^0.468.0",
    "mammoth": "1.12.3",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "^20.14.5",
    "js-yaml": "^4.3.2",
    "parse5": "^7.3.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "js-yaml": "^4.3.2",
    "electron-vite": {
      "esbuild": "0.28.2"
    }
  },
  "build": {
    "appId": "edu.khu.medicalmba.mmllm",
    "productName": "MM_LLM",
    "publish": {
      "provider": "github",
      "owner": "airkjw",
      "repo": "MM_LLM",
      "releaseType": "release"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/@tesseract.js-data/**/4.0.0_best_int/**"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "asarUnpack": [
      "node_modules/@napi-rs/**/*.node",
      "node_modules/tesseract.js-core/**/*.wasm"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "JOUNGWOOK KWON (9T5JLVT8G6)",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "MM_LLM-${version}-${arch}-Setup.${ext}"
    }
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.28.2",
    "@napi-rs/canvas-darwin-arm64": "^1.0.9",
    "@napi-rs/canvas-darwin-x64": "^1.0.9",
    "@napi-rs/canvas-win32-x64-msvc": "^1.0.9",
    "@rollup/rollup-darwin-arm64": "4.63.3"
  }
}
